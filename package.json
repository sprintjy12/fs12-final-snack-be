{
  "name": "fs12-final-snack-be",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec tsx src/app.ts",
    "start": "tsc && node dist/app.js",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:allow": "dotenv -v ALLOW_DB_SEED=true -- prisma db seed",
    "job:statistics:create": "tsx src/jobs/runMonthlyStatisticsJob.ts CREATE_PREVIOUS_MONTH_SNAPSHOT",
    "job:statistics:verify": "tsx src/jobs/runMonthlyStatisticsJob.ts VERIFY_PREVIOUS_MONTH_SNAPSHOT",
    "package:lambda:statistics": "prisma generate && node scripts/package-monthly-statistics-lambda.mjs",
    "ssh": "dotenv -- bash -c 'ssh -i \"$SSH_KEY_PATH\" -L 5432:$DB_HOST:5432 $EC2_USER@$EC2_HOST -N'"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.832.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "@prisma/client": "^6.10.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.7",
    "prisma": "^6.10.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
