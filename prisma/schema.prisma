generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @db.VarChar
  businessNumber       String       @unique @db.VarChar
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  defaultMonthlyBudget Int          @default(0)
  budgets              Budget[]
  invitations          Invitation[]
  orders               Order[]
  products             Product[]
  users                User[]

  @@map("companies")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @db.Uuid
  name            String         @db.VarChar
  email           String         @unique @db.VarChar
  passwordHash    String         @db.VarChar(256)
  role            UserRole       @default(USER)
  status          UserStatus     @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  withdrawnAt     DateTime?
  cartItems       CartItem[]
  processedOrders Order[]        @relation("OrderProcessor")
  requestedOrders Order[]        @relation("OrderRequester")
  createdProducts Product[]      @relation("ProductCreator")
  refreshTokens   RefreshToken[]
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Invitation {
  id        Int            @id @default(autoincrement())
  companyId String         @db.Uuid
  name      String         @db.VarChar
  email     String         @db.VarChar
  role      InvitationRole
  tokenHash String         @unique @db.VarChar(256)
  expiresAt DateTime
  isUsed    Boolean        @default(false)
  createdAt DateTime       @default(now())
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  parentId String?    @db.Uuid
  name     String     @db.VarChar
  depth    Int        @default(1)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid
  categoryId    String      @db.Uuid
  createdById   String      @db.Uuid
  name          String      @db.VarChar
  price         Int
  purchaseCount Int         @default(0)
  imageUrl      String?     @db.VarChar
  stock         Int         @default(0)
  productUrl    String?     @db.VarChar
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  category      Category    @relation(fields: [categoryId], references: [id])
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("ProductCreator", fields: [createdById], references: [id])

  @@index([companyId, name])
  @@map("products")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @db.Uuid
  requesterId     String      @db.Uuid
  processorId     String?     @db.Uuid
  type            OrderType
  status          OrderStatus @default(PENDING)
  productAmount   Int
  shippingFee     Int         @default(0)
  totalPrice      Int
  requestMessage  String?
  responseMessage String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processor       User?       @relation("OrderProcessor", fields: [processorId], references: [id])
  requester       User        @relation("OrderRequester", fields: [requesterId], references: [id])

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  productId    String   @db.Uuid
  unitPrice    Int
  quantity     Int
  subtotal     Int
  productName  String   @db.VarChar
  imageUrl     String?  @db.VarChar
  categoryName String   @db.VarChar
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Budget {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  yearMonth String   @db.VarChar
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, yearMonth])
  @@map("budgets")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(256)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  WITHDRAWN
}

enum InvitationRole {
  USER
  ADMIN
}

enum OrderType {
  REQUEST
  DIRECT
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
